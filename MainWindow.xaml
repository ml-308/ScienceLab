<Window x:Class="ScienceLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ScienceLab.Views"
        mc:Ignorable="d"
        Title="科学实验室 ScienceLab" Height="820" Width="1320"
        MinHeight="620" MinWidth="1000"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧图标导航栏（细窄） ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Width="40" Height="40" CornerRadius="12"
                        Background="{DynamicResource PrimaryBrush}" Margin="0,18,0,16"
                        HorizontalAlignment="Center">
                    <TextBlock Text="🧪" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- 导航图标 -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Checked="OnNavChanged" ToolTip="首页">
                        <TextBlock Text="🏠" FontSize="19" />
                    </RadioButton>
                    <RadioButton x:Name="NavMath" Style="{StaticResource NavItem}" GroupName="nav" Checked="OnNavChanged" ToolTip="数学 · 坐标系">
                        <TextBlock Text="📐" FontSize="19" />
                    </RadioButton>
                    <RadioButton x:Name="NavPhysics" Style="{StaticResource NavItem}" GroupName="nav" Checked="OnNavChanged" ToolTip="物理实验室">
                        <TextBlock Text="⚙️" FontSize="19" />
                    </RadioButton>
                    <RadioButton x:Name="NavChemistry" Style="{StaticResource NavItem}" GroupName="nav" Checked="OnNavChanged" ToolTip="化学实验室">
                        <TextBlock Text="⚗️" FontSize="19" />
                    </RadioButton>
                </StackPanel>

                <!-- 底部：主题切换 -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Button Click="OnToggleTheme" x:Name="ThemeBtn"
                            Width="44" Height="44" Background="Transparent" BorderThickness="0"
                            ToolTip="切换主题" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ThemeIcon" Text="🌙" FontSize="19" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,20">
                <DockPanel>
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle" Text="首页" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="HeaderSub" Text="自由开放的数学 · 物理 · 化学学习工具集" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="ScienceLab v1.0" FontSize="12"
                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- 内容 -->
            <ContentControl Grid.Row="1" x:Name="ContentHost" Content="{x:Static views:ViewsFactory.Home}" />
        </Grid>
    </Grid>
</Window>
